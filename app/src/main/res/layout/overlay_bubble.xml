<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnShot"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_overlay_btn"
            android:padding="10dp"
            android:src="@drawable/ic_camera"
            android:contentDescription="Take a screenshot"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_overlay_btn"
            android:padding="10dp"
            android:src="@drawable/ic_rec"
            android:contentDescription="Start or stop recording"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_overlay_btn"
            android:padding="10dp"
            android:src="@drawable/ic_pause"
            android:contentDescription="Pause or resume"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_bubble">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bubble_logo"
            android:contentDescription="Zrec" />

        <View
            android:id="@+id/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_dot_rec"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
