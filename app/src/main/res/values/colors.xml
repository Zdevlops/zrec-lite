<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Near-black with a warm cast. Cream carries the text, gold is the only
         supporting colour, and red still means exactly one thing: recording. -->
    <color name="bg">#FF0B0A08</color>
    <color name="surface">#FF151310</color>
    <color name="surface2">#FF221E15</color>
    <color name="line">#FF2E2819</color>

    <color name="txt">#FFF5F0E4</color>
    <color name="txtDim">#FFBDB6A4</color>
    <color name="txtFaint">#FF9A9280</color>

    <!-- Thin gold: section labels, the active tab underline, switches and sliders. -->
    <color name="gold">#FFE8C36A</color>
    <color name="goldDim">#FFC7A24F</color>
    <color name="goldPress">#FFA7873F</color>

    <!-- Red means one thing only: recording is happening. -->
    <color name="accent">#FFE5484D</color>
    <color name="accentDeep">#FFC93C41</color>
    <color name="accentPress">#FFAE3338</color>

    <!-- The idle primary action is light, so red never stops meaning "live". -->
    <color name="btnLight">#FFF5F0E4</color>
    <color name="btnLightPress">#FFE0D8C6</color>
    <color name="onAccent">#FFFFFFFF</color>
</resources>
