<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Gold is the accent and red belongs to the recording state, so a switch being
      "on" can never be mistaken for a live take.
    -->
    <style name="Theme.Zrec" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/gold</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:colorControlNormal">@color/txtFaint</item>
        <item name="android:colorControlHighlight">@color/goldDim</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/txt</item>
        <item name="android:textColorSecondary">@color/txtDim</item>
    </style>

    <!-- Small caps label above every group of rows. -->
    <style name="TextZrecSection">
        <item name="android:textColor">@color/goldDim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.Zrec.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/txt</item>
        <item name="android:textColorSecondary">@color/txtDim</item>
        <item name="android:windowTitleStyle">@style/Theme.Zrec.Dialog.Title</item>
    </style>

    <style name="Theme.Zrec.Dialog.Title" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
