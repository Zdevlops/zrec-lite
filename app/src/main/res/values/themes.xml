<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Switches, radios and the seek bar are off-white on purpose. The only
      colour in the interface is the recording state, so a control being "on"
      never competes with it.
    -->
    <style name="Theme.Zrec" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/txt</item>
        <item name="android:colorAccent">@color/txt</item>
        <item name="android:colorControlActivated">@color/txt</item>
        <item name="android:colorControlNormal">@color/txtFaint</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/txt</item>
        <item name="android:textColorSecondary">@color/txtDim</item>
    </style>

    <style name="Theme.Zrec.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/txt</item>
        <item name="android:colorControlActivated">@color/txt</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/txt</item>
        <item name="android:textColorSecondary">@color/txtDim</item>
        <item name="android:windowTitleStyle">@style/Theme.Zrec.Dialog.Title</item>
    </style>

    <style name="Theme.Zrec.Dialog.Title" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/txt</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
